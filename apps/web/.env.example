# Base URL of the core-api backend (no trailing slash).
#
# Local development (default): http://localhost:3000
#
# Vercel / production: core-api (NestJS + Prisma + Neo4j) cannot run on
# Vercel's serverless runtime — it needs a persistent process, pooled
# Postgres connections, and long-lived Neo4j bolt connections. Deploy
# core-api separately (Railway, Render, Fly.io, a VPS, etc.), then set this
# variable to that deployment's public URL as a Project Environment
# Variable in the Vercel dashboard (Settings → Environment Variables) for
# the Production and Preview environments — it must be set at build time
# since NEXT_PUBLIC_* variables are inlined into the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:3000
