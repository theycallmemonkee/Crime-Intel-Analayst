# NEXT_PUBLIC_ variables are inlined into the client bundle at build time,
# so they need to exist wherever `next build` actually runs — including
# hosts with no environment-variable UI/config surface (e.g. Zoho Catalyst
# Slate). Committed on purpose: this is a public API URL, not a secret —
# it ships inside the JS bundle regardless of how it gets in.
#
# Vercel overrides this with its own project-level env var (same value);
# platform env vars always take precedence over .env files in Next.js, so
# this file is a fallback for builds that don't set one, not a conflict.
NEXT_PUBLIC_API_URL=https://core-api-production-1c0f.up.railway.app
