# PostgreSQL (+ PostGIS) connection string.
# Port 55432 matches infra/docker-compose.yml — chosen to avoid clashing with a
# default local Postgres install on 5432. Adjust if you're not using Docker Compose.
DATABASE_URL="postgresql://cip:cip_dev_password@localhost:55432/crime_intel?schema=public"

# Neo4j connection (bolt protocol) — used by the network/link-analysis module.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="cip_dev_password"

# JWT signing secret and access token lifetime. Generate a strong random value
# for any non-local environment, e.g.: openssl rand -base64 48
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="8h"

# Port the NestJS API listens on.
PORT=3000
