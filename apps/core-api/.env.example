# Postgres, hosted on Neon (https://neon.tech) — pooled (PgBouncer) connection
# for the running app, and a direct connection for migrations. Get both from:
#   npx neonctl connection-string --pooled --prisma   (-> DATABASE_URL)
#   npx neonctl connection-string --prisma             (-> DIRECT_URL)
# or from the Neon console: Project -> Connect. Never commit real values here —
# this file only documents the shape/format.
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>/<db>?connect_timeout=30&pool_timeout=30&pgbouncer=true&sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<db>?connect_timeout=30&sslmode=require&channel_binding=require"

# Neo4j connection (bolt protocol) — used by the network/link-analysis module.
# Runs locally via Docker Compose (infra/docker-compose.yml).
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="cip_dev_password"

# JWT signing secret and access token lifetime. Generate a strong random value
# for any non-local environment, e.g.: openssl rand -base64 48
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="8h"

# Port the NestJS API listens on.
PORT=3000
